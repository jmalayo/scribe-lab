# syntax=docker/dockerfile:1
FROM python:3.12-slim AS model

ARG EMBEDDING_REPO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARG EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
ARG ONNX_MODEL_FILE=onnx/model_quint8_avx2.onnx

RUN python - <<PY
import pathlib, urllib.request
base = "https://huggingface.co/${EMBEDDING_REPO}/resolve/${EMBEDDING_REVISION}"
for name in ["tokenizer.json", "${ONNX_MODEL_FILE}"]:
    target = pathlib.Path("/model") / name
    target.parent.mkdir(parents=True, exist_ok=True)
    urllib.request.urlretrieve(f"{base}/{name}", target)
PY

FROM public.ecr.aws/lambda/python:3.12

ARG ONNX_MODEL_FILE=onnx/model_quint8_avx2.onnx

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TEXT_EMBEDDER_MODE=onnx \
    ONNX_MODEL_DIR=/opt/model \
    ONNX_MODEL_FILE=${ONNX_MODEL_FILE} \
    PIPELINE_CONFIG_PATH=app/config/pipeline-cloud.yaml

COPY app/requirements-lambda.txt ${LAMBDA_TASK_ROOT}/app/requirements-lambda.txt
RUN pip install -r ${LAMBDA_TASK_ROOT}/app/requirements-lambda.txt

COPY --from=model /model /opt/model
COPY shared ${LAMBDA_TASK_ROOT}/shared
COPY app ${LAMBDA_TASK_ROOT}/app

CMD ["app.lambda_handler.handler"]
